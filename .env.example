NODE_ENV=development
PORT=3017
DATABASE_URL=postgresql://payment_hub:change-me@localhost:5432/payment_hub
APP_AUTH_ISSUER=https://payments.example.test
APP_AUTH_AUDIENCE=payment-hub
APP_AUTH_TOKENS=app_analytics_pro:change-me-local-token
PAYMENT_HUB_CORS_ALLOW_ORIGIN=http://127.0.0.1:4900

# Server-side only. Use Stripe sandbox values only during local/dev proof.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-02-25.clover

# Phase 3 AIntern local token example. Production AIntern should use Supabase JWT auth instead.
# APP_AUTH_TOKENS=app_analytics_pro:change-me-local-token,aintern:change-me-aintern-local-token

# AIntern production-safe web auth. Prefer JWKS for modern Supabase JWT signing keys.
SUPABASE_JWKS_URL=https://wdhdjhvvngssnszqgiyk.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_APP_ID=aintern
SUPABASE_JWT_ISSUER=https://wdhdjhvvngssnszqgiyk.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Named provider accounts. Keep each company's provider credentials separate.
# `primary` remains a local sandbox compatibility alias only.
STRIPE_ACCOUNTS=primary,nhl_global_solution
STRIPE_ACCOUNT_NHL_GLOBAL_SOLUTION_SECRET_KEY=sk_test_replace_me
STRIPE_ACCOUNT_NHL_GLOBAL_SOLUTION_WEBHOOK_SECRET=whsec_replace_me
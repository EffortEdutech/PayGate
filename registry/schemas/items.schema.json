{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payment-hub.local/schemas/items.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_key", "name", "type", "pricing", "provider", "entitlement", "status"],
        "properties": {
          "item_key": { "type": "string", "pattern": "^(book|bundle):[a-zA-Z0-9][a-zA-Z0-9_.:-]{1,127}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "type": { "enum": ["single_cast", "cast_bundle"] },
          "pricing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["currency", "unit_amount_minor"],
            "properties": {
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
              "unit_amount_minor": { "type": "integer", "minimum": 1 }
            }
          },
          "provider": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lookup_key"],
              "properties": {
                "lookup_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,199}$" },
                "live_lookup_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,199}$" }
              }
            }
          },
          "entitlement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "scope"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.]*$" },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "book_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
                  "bundle_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
                  "book_ids": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }
                  }
                }
              }
            }
          },
          "status": { "enum": ["draft", "active", "archived"] }
        }
      }
    }
  }
}
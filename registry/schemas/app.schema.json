{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payment-hub.local/schemas/app.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app_id", "name", "status", "provider", "billing", "application_urls", "identity"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "app_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": { "enum": ["draft", "active", "suspended", "retired"] },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "account"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" },
        "account": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" }
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "application_urls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test", "live"],
      "properties": {
        "test": { "type": "string", "format": "uri", "pattern": "^(https://|http://(127\\.0\\.0\\.1|localhost)(:[0-9]+)?)" },
        "live": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_reference"],
      "properties": { "user_reference": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" } }
    }
  }
}


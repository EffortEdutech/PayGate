# pageCast -> PayGate integration draft
# No provider secrets belong in pageCast.

NEXT_PUBLIC_PAYMENT_HUB_BASE_URL=https://pay-gate-beta.vercel.app
NEXT_PUBLIC_PAYMENT_HUB_APP_ID=pagecast
NEXT_PUBLIC_PAYMENT_HUB_ENVIRONMENT=test

# PayGate must verify pageCast Supabase JWTs server-side.
# Configure these in PayGate Vercel env vars, not in pageCast browser code:
# SUPABASE_JWT_APPS=pagecast
# SUPABASE_JWT_PAGECAST_JWKS_URL=https://zdlbcvscytujdomxzwei.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_PAGECAST_ISSUER=https://zdlbcvscytujdomxzwei.supabase.co/auth/v1
# SUPABASE_JWT_PAGECAST_AUDIENCE=authenticated